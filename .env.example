# Optional collaboration. Blank values keep local editing available offline.
# These client settings are visible in installed builds. Never use secret/service-role keys.
VITE_CLICKDECK_SUPABASE_URL=
VITE_CLICKDECK_SUPABASE_PUBLISHABLE_KEY=
# Leave blank for existing backend. Use invited-v1 only after coordinated backend
# admission hooks, controlled read RPC and route gate have been verified.
# This selects both invitation-bound signup and controlled POST reads together.
VITE_CLICKDECK_COLLABORATION_PROTOCOL=
# Official distribution only: 1 fixes the ID to the existing Chrome Web Store
# item using its PUBLIC key. Leave blank for isolated development/test installs.
# This does not configure backend callbacks or approve publication.
VITE_CLICKDECK_OFFICIAL_ID=
